#!/bin/sh
set -eu

if [ "$#" -gt 0 ]; then
  case "$1" in
    +*)
      toolchain="${1#+}"
      shift
      exec rustup run "$toolchain" cargo "$@"
      ;;
  esac
fi

# Prefer Homebrew's toolchain where it exists; otherwise use the next one on PATH,
# skipping this shim directory so the call cannot recurse.
self_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
if [ -x "/opt/homebrew/bin/cargo" ]; then
  exec "/opt/homebrew/bin/cargo" "$@"
fi
PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$self_dir" | paste -sd: -)"
export PATH
exec cargo "$@"
