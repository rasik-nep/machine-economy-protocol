{
  "name": "machine-economy-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Machine Economy Protocol MVP monorepo.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.13.1"
  },
  "scripts": {
    "anchor:build": "PATH=\"$PWD/scripts/toolchain:$PATH\" anchor build --arch v2",
    "anchor:test": "scripts/anchor-test.sh",
    "check": "pnpm run format:check && pnpm run lint && pnpm run test",
    "doctor": "node scripts/doctor.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "market:build": "node scripts/build-market.mjs",
    "contract:build": "node scripts/build-contract.mjs",
    "subcontract:build": "node scripts/build-subcontract.mjs",
    "localnet:start": "solana-test-validator --reset",
    "localnet:status": "solana cluster-version --url http://127.0.0.1:8899",
    "test": "vitest run",
    "dev": "node scripts/build-dashboard.mjs && node --experimental-strip-types scripts/demo.mjs",
    "router:verify": "node --experimental-strip-types examples/independent-router/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:gemini": "node --experimental-strip-types scripts/test-gemini.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.56.1",
    "@types/bn.js": "5.2.0",
    "@types/node": "24.5.2",
    "eslint": "9.36.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@solana/web3.js": "1.98.4",
    "zod": "3.25.76"
  }
}
