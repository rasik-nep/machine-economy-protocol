{
  "name": "machine-economy-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Machine Economy Protocol MVP monorepo.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=23.11.0",
    "pnpm": ">=10.13.1"
  },
  "scripts": {
    "anchor:build": "PATH=\"$PWD/scripts/toolchain:$PATH\" anchor build --arch v2",
    "anchor:test": "scripts/anchor-test.sh",
    "check": "pnpm run format:check && pnpm run lint && pnpm run test",
    "doctor": "node scripts/doctor.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "localnet:start": "solana-test-validator --reset",
    "localnet:status": "solana cluster-version --url http://127.0.0.1:8899",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "24.5.2",
    "eslint": "9.36.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.45.0",
    "vitest": "3.2.4"
  }
}
