# Localnet is the default development cluster.
SOLANA_CLUSTER=localnet
SOLANA_RPC_URL=http://127.0.0.1:8899

# Used by the Anchor CLI only. The demo server generates its own disposable
# wallets in .anchor/demo-wallets.json. Never use a wallet with mainnet funds.
ANCHOR_WALLET=

# Optional during early development. Core protocol logic must work without it.
GEMINI_API_KEY=


# Optional advisory summaries only; never controls settlement.
GEMINI_MODEL=gemini-3.8-flash
